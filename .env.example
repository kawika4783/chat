NODE_ENV=production
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080

# Leave these local tags for source builds. For GHCR installs, replace OWNER.
HALO_WEB_IMAGE=halo-web:local
HALO_API_IMAGE=halo-api:local
HALO_RECORDER_IMAGE=halo-recording-worker:local
# HALO_WEB_IMAGE=ghcr.io/OWNER/halo-web:latest
# HALO_API_IMAGE=ghcr.io/OWNER/halo-api:latest
# HALO_RECORDER_IMAGE=ghcr.io/OWNER/halo-recording-worker:latest

POSTGRES_USER=halo
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=halo
SESSION_SECRET=replace-with-at-least-32-random-bytes
OTP_MODE=mock
MOCK_OTP_CODE=147296
SMS_PROVIDER=mock
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:turn.example.com:3478
TURN_USERNAME=replace-me
TURN_PASSWORD=replace-me
VIDEO_RECORDING_ENABLED=true
VIDEO_RECORDING_RETENTION_DAYS=30
RECORDING_BUCKET=halo-video-recordings
RECORDING_STORAGE_ENDPOINT=http://object-storage:9000
RECORDING_STORAGE_ACCESS_KEY=halo_recordings
RECORDING_STORAGE_SECRET_KEY=change-this-recording-storage-password
RECORDING_KMS_KEY_ID=replace-with-managed-kms-key
RECORDING_SIGNED_URL_TTL_SECONDS=120
MINIO_CONSOLE_PORT=9001
COOKIE_SECURE=false
TRUST_PROXY=false
