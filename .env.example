NODE_ENV=production
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# Hostinger Traefik production routing. All three DNS names point to the VPS.
HALO_DOMAIN=808hub.net
HALO_CHAT_DOMAIN=chat.808hub.net
LIVEKIT_DOMAIN=livekit.808hub.net
TRAEFIK_HTTP_ENTRYPOINT=web
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Leave these local tags for source builds. Uncomment the GHCR tags for image-only installs.
HALO_WEB_IMAGE=halo-web:local
HALO_API_IMAGE=halo-api:local
# HALO_WEB_IMAGE=ghcr.io/kawika4783/halo-web:latest
# HALO_API_IMAGE=ghcr.io/kawika4783/halo-api:latest

POSTGRES_USER=halo
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=halo
SESSION_SECRET=replace-with-at-least-32-random-bytes
OTP_MODE=mock
# Development only: the live sign-in screen displays this code.
MOCK_OTP_CODE=147296
SMS_PROVIDER=mock
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
LIVEKIT_PUBLIC_URL=wss://livekit.808hub.net
LIVEKIT_NODE_IP=2.25.84.233
LIVEKIT_HTTP_BIND_ADDRESS=127.0.0.1
LIVEKIT_RTC_BIND_ADDRESS=0.0.0.0
LIVEKIT_HTTP_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_TURN_UDP_PORT=3478
VIDEO_RECORDING_ENABLED=true
VIDEO_RECORDING_RETENTION_DAYS=30
RECORDING_BUCKET=halo-video-recordings
MESSAGE_MEDIA_BUCKET=halo-message-media
MESSAGE_MEDIA_RETENTION_DAYS=365
MESSAGE_MEDIA_SIGNED_URL_TTL_SECONDS=3600
RECORDING_STORAGE_ENDPOINT=http://object-storage:9000
RECORDING_PUBLIC_ENDPOINT=https://808hub.net
RECORDING_STORAGE_ACCESS_KEY=halo_recordings
RECORDING_STORAGE_SECRET_KEY=change-this-recording-storage-password
RECORDING_KMS_KEY_ID=replace-with-managed-kms-key
RECORDING_SIGNED_URL_TTL_SECONDS=120
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000

# Disabled by default. For first deployment, enable this and inject the password
# through the environment or BOOTSTRAP_ADMIN_PASSWORD_FILE. Disable it afterward.
ADMIN_BOOTSTRAP_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=replace-admin-username
BOOTSTRAP_ADMIN_PASSWORD=
COOKIE_SECURE=true
TRUST_PROXY=true
